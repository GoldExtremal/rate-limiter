APP_PORT=8080
APP1_PORT=8001
APP2_PORT=8002

POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgresql://ratelimiter:local-dev-only@postgres:5432/ratelimiter
SEED_CLIENT_LIMITS={"client-a": 500, "client-b": 50, "client-c": 1000}

REDIS_URL=redis://redis:6379/0
RATE_LIMIT=100
WINDOW_SEC=60
FAIL_MODE_OPEN=true
REDIS_TIMEOUT_MS=500
REDIS_MAX_CONNECTIONS=64
REDIS_QUEUE_TIMEOUT_MS=1000
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SEC=5
BREAKER_WINDOW_SEC=10
BREAKER_MIN_CALLS=10
BREAKER_FAILURE_RATIO=0.5
LIMITS_QUERY_TIMEOUT_MS=1000
LIMITS_REFRESH_SEC=10
PROTECTED_PATHS=["/demo"]
LOG_LEVEL=info
LOG_FORMAT=json

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=local-dev-only
